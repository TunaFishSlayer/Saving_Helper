# ----------------------------------------
# DEVELOPMENT ENVIRONMENT
# ----------------------------------------
# Use a Node base image suitable for running development servers
FROM node:24-alpine

WORKDIR /usr/src/app

# Copy package.json and install dependencies
COPY package*.json ./
RUN npm install

# Expose Vite's default development server port
EXPOSE 5173

# Command to start the Vite development server
# The '--host 0.0.0.0' is CRITICAL for running inside Docker, 
# ensuring the dev server is accessible from your host machine.
CMD [ "npm", "run", "dev", "--", "--host", "0.0.0.0" ]