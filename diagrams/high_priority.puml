@startuml system_architecture
' ─────────────────────────────────────────────
' Diagram 1: System Architecture
' ─────────────────────────────────────────────
!theme plain
skinparam backgroundColor #FAFAFA
skinparam componentStyle rectangle
skinparam defaultFontName Arial
title System Architecture — Savings Helper

actor "User / Browser" as user
actor "Android App\n(Capacitor)" as android

package "Frontend\n(React + Vite + Capacitor)" as frontend {
  component "React App\n(Pages + Components)" as react
  component "Context Providers\n(Auth, Language, Currency)" as ctx
  component "IndexedDB\n(Dexie.js)" as indexdb
  component "Sync Queue" as syncq
}

package "Backend\n(Node.js + Express)" as backend {
  component "REST API\n(Routes + Controllers)" as api
  component "Auth Middleware\n(JWT Verify)" as authmw
  component "Service Layer\n(Business Logic)" as svc
  component "Subscription Scheduler\n(Cron Job)" as scheduler
  database "SQLite\n(Prisma ORM)" as db
}

package "OCR Microservice\n(Python + FastAPI)" as ocr {
  component "FastAPI Router" as fastapi
  component "PaddleOCR / VietOCR\n(Text Extraction)" as paddleocr
  component "Groq LLM API\n(Structured Parsing)" as groq
}

user --> react : HTTPS
android --> react : WebView

react --> ctx
react <--> indexdb : Read/Write\n(offline storage)
react --> syncq : Queue mutations\nwhen offline
syncq --> api : POST /api/sync\n(when online)

react --> api : REST calls\nAuthorization: Bearer <JWT>
api --> authmw : Verify token
authmw --> svc
svc --> db : Prisma queries
scheduler --> svc : Cron-triggered\nsubscription billing

react --> fastapi : POST /scan\n(multipart image)
fastapi --> paddleocr : Extract raw text
paddleocr --> fastapi
fastapi --> groq : Analyze text
groq --> fastapi : Structured JSON
fastapi --> react : {amount, description, category}

@enduml


