@startuml layered_architecture
' ─────────────────────────────────────────────
' Diagram 3: Layered Architecture (3-tier)
' ─────────────────────────────────────────────
!theme plain
skinparam defaultFontName Arial
skinparam backgroundColor #FAFAFA
title Kiến trúc Phân tầng (Layered Architecture) — Savings Helper

package "Tầng Trình bày\n(Presentation Layer)" as presentation {
  component "Pages\n(Dashboard, Transactions, Budget,\nGoals, Subscriptions, Profile...)" as pages
  component "Shared Components\n(Header, BottomNavbar, Modals,\nFormattedAmountInput, FAB)" as components
  component "React Contexts\n(AuthContext, LanguageContext,\nCurrencyContext)" as contexts
  component "Services (Client)\n(transactionService, goalService,\nbugdetService, syncService...)" as clientsvc
}

package "Tầng API\n(API Layer)" as api_layer {
  component "Express Router\n(routes/auth, transactions,\nbudgets, goals, subscriptions, sync)" as routes
  component "Controllers\n(authController, transactionController,\nbudgetController, goalController,\nsubscriptionController, syncController)" as controllers
  component "Middlewares\n(authMiddleware, errorHandler,\nrateLimiter, requestLogger)" as middlewares
}

package "Tầng Nghiệp vụ\n(Service Layer)" as service_layer {
  component "Services\n(UserService, TransactionService,\nBudgetService, GoalService,\nSubscriptionService, SyncService)" as services
  component "Cron Scheduler\n(subscriptionScheduler)" as scheduler
  component "Utilities\n(hashUtils, resetCodeUtils,\nformatters)" as utils
}

package "Tầng Dữ liệu\n(Data Layer)" as data_layer {
  component "Prisma Client\n(Type-safe ORM)" as prisma
  database "SQLite Database\n(backend/prisma/dev.db)" as db
}

presentation --> api_layer : REST (HTTP/HTTPS)\nAuthorization: Bearer JWT
api_layer --> service_layer : Delegated business logic
service_layer --> data_layer : ORM queries
scheduler --> service_layer : Cron-triggered billing
data_layer --> db

@enduml
