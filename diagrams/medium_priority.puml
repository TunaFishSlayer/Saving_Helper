@startuml activity_ai_scan
' ─────────────────────────────────────────────
' Diagram 4: AI OCR Scan Activity Diagram
' ─────────────────────────────────────────────
!theme plain
skinparam defaultFontName Arial
title Activity Diagram — AI Đọc Hóa Đơn (OCR Scan Flow)

start

:Người dùng nhấn nút "AI đọc giao dịch";
:Chọn hoặc chụp ảnh hóa đơn;
:Hiển thị trạng thái\n"AI đang đọc hóa đơn của bạn...";

:Gửi ảnh đến OCR Microservice\n(POST /scan — multipart/form-data);

fork
  :PaddleOCR / VietOCR\ntrích xuất văn bản từ ảnh;
fork again
  note right: Xử lý song song\ntrên FastAPI service
end fork

:Gửi văn bản đã trích xuất\nđến Groq LLM API;
:LLM phân tích ngữ nghĩa\nvà trả về JSON có cấu trúc\n{amount, description, category};

if (Phân tích thành công?) then (Có)
  :Điền tự động vào form giao dịch\n(Số tiền, Mô tả, Danh mục);
  :Hiển thị toast:\n"Đọc hóa đơn thành công!";
  :Người dùng kiểm tra và\nchỉnh sửa nếu cần;
  :Xác nhận và lưu giao dịch;
else (Thất bại)
  :Hiển thị toast:\n"Quét AI thất bại. Vui lòng nhập thủ công.";
  :Mở form nhập liệu trống;
  :Người dùng tự nhập thông tin;
endif

stop
@enduml


@startuml activity_offline_sync
' ─────────────────────────────────────────────
' Diagram 5: Offline & Cloud Sync Activity Diagram
' ─────────────────────────────────────────────
!theme plain
skinparam defaultFontName Arial
title Activity Diagram — Chế độ Offline & Đồng bộ Dữ liệu Cloud

start

:Người dùng mở ứng dụng;

if (Có kết nối mạng?) then (Có)
  if (Đã đăng nhập?) then (Có)
    :Xác thực JWT token;
    :GET /api/sync — Tải dữ liệu từ Server;
    :Self-heal: gán clientUuid cho\nbản ghi bị thiếu (= id);
    :Lưu vào IndexedDB (Dexie.js);
    :Header hiển thị "Cloud Sync ✓";
  else (Không)
    :Chế độ Guest;
    :Tải từ IndexedDB (nếu có);
  endif
else (Không có mạng)
  :Chế độ Offline;
  :Tải toàn bộ dữ liệu từ IndexedDB;
  :Header hiển thị "Offline Mode";
endif

:Người dùng thực hiện thao tác\n(Thêm / Sửa / Xóa giao dịch...);

if (Đang online?) then (Có)
  :Gửi trực tiếp lên Server\n(POST/PUT/DELETE /api/...);
  :Cập nhật IndexedDB đồng thời;
else (Offline)
  :Lưu vào IndexedDB;
  :Thêm vào Sync Queue\n(pending mutations);
endif

if (Kết nối mạng trở lại?) then (Có)
  if (Sync Queue có dữ liệu chờ?) then (Có)
    :POST /api/sync\n{creates[], updates[], deletes[]};
    if (Xung đột dữ liệu?) then (Có)
      :Hiển thị dialog:\n"Ghi đè dữ liệu cloud?" (Merge / Overwrite);
      :Người dùng chọn hành động;
    else (Không)
      :Server tự động merge theo clientUuid;
    endif
    :Xóa Sync Queue;
    :Header cập nhật "Cloud Sync ✓";
  else (Không có gì chờ)
    :Không cần đồng bộ;
  endif
endif

stop
@enduml


@startuml sequence_login_jwt
' ─────────────────────────────────────────────
' Diagram 6: Login & JWT Authentication Sequence
' ─────────────────────────────────────────────
!theme plain
skinparam defaultFontName Arial
title Sequence Diagram — Đăng nhập & JWT Authentication

actor "Người dùng" as user
participant "React Frontend" as frontend
participant "Express Backend\n/api/auth" as backend
database "SQLite (Prisma)" as db

user -> frontend: Nhập email + password
frontend -> backend: POST /api/auth/login\n{email, password}
backend -> db: SELECT user WHERE email = ?
db --> backend: User record {passwordHash}
backend -> backend: bcrypt.compare(password, hash)

alt Xác thực thành công
  backend -> backend: jwt.sign({userId}, secret,\n{expiresIn: '7d'})
  backend --> frontend: 200 OK {token, user}
  frontend -> frontend: Lưu token vào localStorage
  frontend -> frontend: Cập nhật AuthContext.user
  frontend --> user: Redirect → Dashboard
else Sai mật khẩu / không tồn tại
  backend --> frontend: 401 Unauthorized
  frontend --> user: Hiển thị thông báo lỗi
end

note over frontend, backend
  Mọi request tiếp theo đều gửi kèm:
  Authorization: Bearer <JWT token>
end note

frontend -> backend: GET /api/transactions\nAuthorization: Bearer <token>
backend -> backend: authMiddleware:\njwt.verify(token, JWT_SECRET)

alt Token hợp lệ
  backend -> db: SELECT * FROM Transaction\nWHERE userId = decoded.userId
  db --> backend: Transaction[]
  backend --> frontend: 200 OK {data: [...]}
else Token hết hạn / không hợp lệ
  backend --> frontend: 401 Unauthorized
  frontend -> frontend: logout() — xóa token
  frontend --> user: Redirect → Login
end

@enduml


@startuml sequence_sync
' ─────────────────────────────────────────────
' Diagram 7: Cloud Sync Handshake Sequence
' ─────────────────────────────────────────────
!theme plain
skinparam defaultFontName Arial
title Sequence Diagram — Cloud Sync Handshake

participant "React Frontend\n(SyncService + IndexedDB)" as frontend
participant "Express Backend\n/api/sync" as backend
database "SQLite (Prisma)" as db

== Phase 1: Pull — Server → Client ==

frontend -> backend: GET /api/sync\nAuthorization: Bearer <JWT>
backend -> db: Fetch all records for userId\n(categories, transactions,\nbudgets, goals, subscriptions)
backend -> backend: Self-heal:\nassign clientUuid = id\nfor any NULL records
db --> backend: All records[]
backend --> frontend: 200 OK\n{categories[], transactions[],\nbudgets[], goals[], subscriptions[]}
frontend -> frontend: Upsert into IndexedDB\nkeyed by clientUuid

== Phase 2: Push — Client → Server ==

frontend -> frontend: Read Sync Queue\n(pending mutations)
frontend -> backend: POST /api/sync\n{creates[], updates[], deletes[]}
backend -> db: Apply mutations:\nupsert by clientUuid\ndelete by clientUuid
db --> backend: Success
backend --> frontend: 200 OK {synced: true}
frontend -> frontend: Clear Sync Queue
frontend -> frontend: Update header status:\n"Cloud Sync ✓"

@enduml
