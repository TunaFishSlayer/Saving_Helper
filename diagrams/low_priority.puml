@startuml activity_create_subscription
' ─────────────────────────────────────────────
' Diagram 8: Create Subscription Activity Diagram
' ─────────────────────────────────────────────
!theme plain
skinparam defaultFontName Arial
title Activity Diagram — Tạo & Quản lý Dịch Vụ Định Kỳ (Subscription)

start

:Người dùng nhấn "Thêm Dịch Vụ";
:Mở modal tạo subscription;
:Nhập thông tin:
  - Tên dịch vụ (VD: Netflix, Spotify)
  - Danh mục
  - Số tiền thanh toán
  - Chu kỳ: weekly / monthly / yearly
  - Ngày thanh toán tiếp theo;

if (Dữ liệu hợp lệ?) then (Có)
  :POST /api/subscriptions;
  :Lưu vào bảng Subscription\n(isActive = true);
  :Subscription Scheduler (cron) chạy định kỳ;

  fork
    :Kiểm tra nextBillingDate\ncủa tất cả subscription active;
  fork again
    note right: Chạy nền mỗi ngày\nkhi backend khởi động
  end fork

  if (Đến ngày thanh toán?) then (Có)
    :Tự động tạo giao dịch chi tiêu\n(Transaction: type = "expense");
    :Cập nhật nextBillingDate\ntheo billingCycle;
  else (Chưa đến ngày)
    :Không làm gì, chờ đến kỳ tiếp;
  endif

  :Hiển thị trong danh sách Dịch Vụ;

  if (Người dùng muốn hủy?) then (Có)
    :Hiển thị modal xác nhận hủy;
    if (Xác nhận hủy?) then (Có)
      :DELETE /api/subscriptions/:id;
      :Xóa khỏi danh sách;
    else (Hủy bỏ)
      :Giữ nguyên dịch vụ;
    endif
  endif

else (Không hợp lệ)
  :Hiển thị thông báo lỗi validation;
  :Yêu cầu nhập lại;
endif

stop
@enduml


@startuml activity_goal_funds
' ─────────────────────────────────────────────
' Diagram 9: Create Goal & Add Funds Activity Diagram
' ─────────────────────────────────────────────
!theme plain
skinparam defaultFontName Arial
title Activity Diagram — Tạo Mục Tiêu Tích Lũy & Nạp Tiền (Goal)

start

partition "Tạo Mục Tiêu" {
  :Nhấn "Thêm Mục Tiêu";
  :Nhập thông tin:
    - Tên mục tiêu (VD: Laptop mới)
    - Số tiền mục tiêu
    - Hạn chót (tùy chọn);

  if (Dữ liệu hợp lệ?) then (Có)
    :POST /api/goals;
    :Lưu vào DB (currentAmount = 0);
    :Hiển thị goal card\nvới progress bar 0%;
  else (Không)
    :Hiển thị lỗi;
    :Yêu cầu nhập lại;
  endif
}

partition "Nạp Tiền vào Mục Tiêu" {
  :Nhấn "Nạp Tiền" trên goal card;
  :Mở modal "Nạp Tiền Vào [Tên Mục Tiêu]";
  :Nhập số tiền muốn nạp;

  if (Số tiền hợp lệ (> 0)?) then (Có)
    :PATCH /api/goals/:id\n{amount: số tiền nạp};
    :currentAmount += số tiền nạp;
    :Cập nhật progress bar;

    if (currentAmount >= targetAmount?) then (Đạt 100%)
      :Progress bar chuyển màu xanh lá;
      :Hiển thị "Đã đạt mục tiêu!";
    else (Chưa đạt)
      :Hiển thị % tiến độ mới;
    endif

    :Cập nhật biểu đồ Donut\nphân bổ danh mục trên Goals page;
  else (Không hợp lệ)
    :Hiển thị lỗi;
  endif
}

partition "Xóa Mục Tiêu" {
  :Nhấn icon xóa trên goal card;
  :Hiển thị modal xác nhận xóa;
  if (Xác nhận xóa?) then (Có)
    :DELETE /api/goals/:id;
    :Xóa khỏi danh sách;
    :Cập nhật biểu đồ Donut;
  else (Hủy bỏ)
    :Đóng modal, không làm gì;
  endif
}

stop
@enduml


@startuml component_tree
' ─────────────────────────────────────────────
' Diagram 10: Frontend React Component Tree
' ─────────────────────────────────────────────
!theme plain
skinparam defaultFontName Arial
skinparam backgroundColor #FAFAFA
title Frontend Component Tree — Savings Helper (React)

package "main.jsx — Entry Point" {
  component "App.jsx" as app
}

package "Context Providers (Global State)" {
  component "AuthProvider\n(user, login, logout)" as authctx
  component "LanguageProvider\n(locale, t())" as langctx
  component "CurrencyProvider\n(currency, formatCurrency())" as currctx
}

package "Router (React Router v6)" {
  component "ProtectedRoute" as prot
  component "PublicRoute\n(Login, Register, ForgotPassword)" as pub
}

package "Layout Shell" {
  component "MainLayout" as layout
  component "Header\n(Greeting, Sync Status,\nLanguage + Currency Selector)" as header
  component "Sidebar\n(Nav Links, Logout)" as sidebar
  component "BottomNavbar\n(Mobile — 6 tabs)" as bottom
}

package "Pages" {
  component "Dashboard\n(6 Charts + Stats)" as dash
  component "Transaction\n(Table/Cards + FAB)" as trans
  component "Budget\n(Grid Cards + Progress)" as budget
  component "Category\n(Grid + Filters)" as cat
  component "Goals\n(Cards + Donut Chart)" as goals
  component "Subscriptions\n(Table/Cards + Scheduler)" as subs
  component "Profile\n(3 Tabs: Info/Password/Danger)" as profile
}

package "Shared / Reusable Components" {
  component "FormattedAmountInput\n(IME-safe currency input)" as fai
  component "Custom Confirm Modal\n(2-step deletion)" as modal
  component "Toast Notifications\n(react-hot-toast)" as toast
  component "Floating Action Button\n(Mobile — Add/Scan)" as fab
}

app --> authctx
authctx --> langctx
langctx --> currctx
currctx --> prot
currctx --> pub

prot --> layout
layout --> header
layout --> sidebar
layout --> bottom
layout --> dash
layout --> trans
layout --> budget
layout --> cat
layout --> goals
layout --> subs
layout --> profile

trans --> fai
trans --> modal
trans --> fab
trans --> toast

budget --> fai
budget --> modal
budget --> toast

goals --> fai
goals --> modal
goals --> toast

subs --> modal
subs --> toast

profile --> modal

@enduml
